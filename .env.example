# ==============================================================================
# E SELLER STORE - ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- SMTP MAIL TRANSPORT (Nodemailer / Standard Mail Server) ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="E Seller Store Security <auth@esellerstorebay.com>"

# --- ALTERNATIVE API MAIL PROVIDERS (Optional) ---
# Resend API Key (https://resend.com)
RESEND_API_KEY=re_123456789_abcdefg

# SendGrid API Key (https://sendgrid.com)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# --- PLATFORM CONFIGURATION ---
PLATFORM_BASE_URL=https://ssellerstorebay.com
NODE_ENV=production
